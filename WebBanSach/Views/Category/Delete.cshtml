@model Category
@{
    ViewData["Title"] = "Xác Nhận Xóa Danh Mục";
}

<div class="container px-4 px-lg-5 py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none"><i class="bi bi-house-door me-1"></i>Trang Chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Category" asp-action="Index" class="text-muted text-decoration-none">Danh Mục Sách</a></li>
            <li class="breadcrumb-item active text-danger fw-semibold" aria-current="page">Xác Nhận Xóa</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="border: 1px solid rgba(222, 192, 183, 0.45) !important; background-color: #ffffff;">
                <div class="card-header bg-danger bg-gradient text-white py-3 px-4 d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <h4 class="font-serif fw-bold mb-0">Xác Nhận Xóa Danh Mục</h4>
                </div>
                <div class="card-body p-4 bg-white">
                    <div class="alert alert-warning d-flex align-items-center mb-4 rounded-3" role="alert" style="background-color: #fff3cd; color: #664d03; border: 1px solid #ffe69c;">
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5 text-warning"></i>
                        <div>
                            <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa danh mục <strong>"@Model.Name"</strong>? Hành động này sẽ xóa dữ liệu vĩnh viễn và không thể hoàn tác.
                        </div>
                    </div>

                    <form method="post" asp-action="Delete" asp-route-id="@Model.Id">
                        <input asp-for="Id" hidden />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;"></label>
                            <input asp-for="Name" disabled class="form-control rounded-3 p-3 bg-surface-low text-dark" style="border: 1px solid rgba(222, 192, 183, 0.6);" />
                        </div>

                        <div class="mb-4">
                            <label asp-for="DisplayOrder" class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;"></label>
                            <input asp-for="DisplayOrder" disabled class="form-control rounded-3 p-3 bg-surface-low text-dark" style="border: 1px solid rgba(222, 192, 183, 0.6);" />
                        </div>

                        <div class="d-flex align-items-center gap-3 pt-3 border-top" style="border-color: rgba(222, 192, 183, 0.35) !important;">
                            <button type="submit" class="btn btn-danger rounded-pill px-4 d-inline-flex align-items-center gap-2">
                                <i class="bi bi-trash-fill"></i>
                                <span>Xác nhận xóa</span>
                            </button>
                            <a asp-controller="Category" asp-action="Index" class="btn btn-secondary rounded-pill px-4">
                                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
