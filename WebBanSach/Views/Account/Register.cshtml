@model RegisterVM
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản Mới";
}

<div class="container px-4 px-lg-5 py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="border: 1px solid rgba(222, 192, 183, 0.45) !important; background-color: #ffffff;">
                <div class="card-header bg-surface-low border-bottom py-4 px-4 text-center" style="border-color: rgba(222, 192, 183, 0.4) !important;">
                    <div class="rounded-circle bg-terracotta text-white d-inline-flex align-items-center justify-content-center shadow-sm mb-3" style="width: 52px; height: 52px; font-size: 1.4rem;">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <h3 class="font-serif fw-bold text-dark mb-1">Đăng Ký Hội Viên PageCraft</h3>
                    <p class="text-muted small mb-0">Tạo tài khoản để nhận ưu đãi, lưu danh sách yêu thích và theo dõi đơn hàng</p>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form method="post" asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 px-3 small mb-4" role="alert"></div>

                        <div class="row g-3">
                            <!-- Full Name -->
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-surface-low border-end-0 text-muted" style="border-color: rgba(222, 192, 183, 0.7);">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    <input asp-for="FullName" class="form-control rounded-end-3 p-3 bg-white text-dark" placeholder="Ví dụ: Nguyễn Văn A" style="border-color: rgba(222, 192, 183, 0.7);" />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-surface-low border-end-0 text-muted" style="border-color: rgba(222, 192, 183, 0.7);">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input asp-for="Email" class="form-control rounded-end-3 p-3 bg-white text-dark" placeholder="email@domain.com" style="border-color: rgba(222, 192, 183, 0.7);" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Password -->
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-surface-low border-end-0 text-muted" style="border-color: rgba(222, 192, 183, 0.7);">
                                        <i class="bi bi-shield-lock"></i>
                                    </span>
                                    <input asp-for="Password" type="password" class="form-control rounded-end-3 p-3 bg-white text-dark" placeholder="Ít nhất 6 ký tự..." style="border-color: rgba(222, 192, 183, 0.7);" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <!-- Confirm Password -->
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-surface-low border-end-0 text-muted" style="border-color: rgba(222, 192, 183, 0.7);">
                                        <i class="bi bi-shield-check"></i>
                                    </span>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control rounded-end-3 p-3 bg-white text-dark" placeholder="Nhập lại mật khẩu..." style="border-color: rgba(222, 192, 183, 0.7);" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <!-- Phone Number -->
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-surface-low border-end-0 text-muted" style="border-color: rgba(222, 192, 183, 0.7);">
                                        <i class="bi bi-telephone"></i>
                                    </span>
                                    <input asp-for="PhoneNumber" class="form-control rounded-end-3 p-3 bg-white text-dark" placeholder="Số điện thoại di động..." style="border-color: rgba(222, 192, 183, 0.7);" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <!-- City -->
                            <div class="col-md-6">
                                <label asp-for="City" class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-surface-low border-end-0 text-muted" style="border-color: rgba(222, 192, 183, 0.7);">
                                        <i class="bi bi-geo-alt"></i>
                                    </span>
                                    <input asp-for="City" class="form-control rounded-end-3 p-3 bg-white text-dark" placeholder="TP. Hồ Chí Minh, Hà Nội..." style="border-color: rgba(222, 192, 183, 0.7);" />
                                </div>
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>

                            <!-- Address -->
                            <div class="col-md-8">
                                <label asp-for="Address" class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-surface-low border-end-0 text-muted" style="border-color: rgba(222, 192, 183, 0.7);">
                                        <i class="bi bi-house"></i>
                                    </span>
                                    <input asp-for="Address" class="form-control rounded-end-3 p-3 bg-white text-dark" placeholder="Số nhà, tên đường, phường/xã..." style="border-color: rgba(222, 192, 183, 0.7);" />
                                </div>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>

                            <!-- Postal Code -->
                            <div class="col-md-4">
                                <label asp-for="PostalCode" class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-surface-low border-end-0 text-muted" style="border-color: rgba(222, 192, 183, 0.7);">
                                        <i class="bi bi-mailbox"></i>
                                    </span>
                                    <input asp-for="PostalCode" class="form-control rounded-end-3 p-3 bg-white text-dark" placeholder="700000" style="border-color: rgba(222, 192, 183, 0.7);" />
                                </div>
                                <span asp-validation-for="PostalCode" class="text-danger small"></span>
                            </div>

                            <!-- Optional Role Selection (nếu User đang là Admin hoặc hệ thống cho phép) -->
                            @if (User.IsInRole(WebBanSach.Utility.SD.Role_Admin))
                            {
                                <div class="col-12">
                                    <label asp-for="Role" class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;"></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-surface-low border-end-0 text-muted" style="border-color: rgba(222, 192, 183, 0.7);">
                                            <i class="bi bi-shield-check text-terracotta"></i>
                                        </span>
                                        <select asp-for="Role" asp-items="@Model.RoleList" class="form-select rounded-end-3 p-3 bg-white text-dark" style="border-color: rgba(222, 192, 183, 0.7);">
                                            <option disabled selected>-- Chọn Phân Quyền --</option>
                                        </select>
                                    </div>
                                    <small class="text-muted">Chỉ Quản trị viên mới thấy tùy chọn phân quyền tài khoản này.</small>
                                </div>
                            }
                        </div>

                        <!-- Submit Button -->
                        <div class="mt-4 pt-2">
                            <button type="submit" class="btn btn-terracotta w-100 py-3 rounded-pill fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-2 mb-3">
                                <i class="bi bi-check-circle-fill fs-5"></i>
                                <span>Tạo Tài Khoản Mới</span>
                            </button>

                            <div class="text-center small text-muted">
                                Đã có tài khoản PageCraft? 
                                <a asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" class="text-terracotta fw-semibold text-decoration-none">
                                    Đăng nhập tại đây
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
