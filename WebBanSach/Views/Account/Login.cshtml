@model LoginVM
@{
    ViewData["Title"] = "Đăng Nhập Tài Khoản";
}

<div class="container px-4 px-lg-5 py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <!-- Login Card -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="border: 1px solid rgba(222, 192, 183, 0.45) !important; background-color: #ffffff;">
                <div class="card-header bg-surface-low border-bottom py-4 px-4 text-center" style="border-color: rgba(222, 192, 183, 0.4) !important;">
                    <div class="rounded-circle bg-terracotta text-white d-inline-flex align-items-center justify-content-center shadow-sm mb-3" style="width: 52px; height: 52px; font-size: 1.4rem;">
                        <i class="bi bi-person-lock"></i>
                    </div>
                    <h3 class="font-serif fw-bold text-dark mb-1">Đăng Nhập PageCraft</h3>
                    <p class="text-muted small mb-0">Truy cập tài khoản hội viên và hệ thống quản trị nhà sách</p>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form method="post" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 px-3 small mb-3" role="alert"></div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-surface-low border-end-0 text-muted" style="border-color: rgba(222, 192, 183, 0.7);">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input asp-for="Email" id="loginEmail" class="form-control rounded-end-3 p-3 bg-white text-dark" placeholder="vidu@pagecraft.com" style="border-color: rgba(222, 192, 183, 0.7);" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="Password" class="form-label fw-bold text-dark small text-uppercase mb-0" style="letter-spacing: 0.05em;"></label>
                                <a href="#" class="small text-muted text-decoration-none hover-underline">Quên mật khẩu?</a>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text bg-surface-low border-end-0 text-muted" style="border-color: rgba(222, 192, 183, 0.7);">
                                    <i class="bi bi-shield-lock"></i>
                                </span>
                                <input asp-for="Password" id="loginPassword" type="password" class="form-control rounded-end-3 p-3 bg-white text-dark" placeholder="Nhập mật khẩu..." style="border-color: rgba(222, 192, 183, 0.7);" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Remember Me -->
                        <div class="form-check mb-4">
                            <input asp-for="RememberMe" class="form-check-input" style="border-color: rgba(222, 192, 183, 0.8);" />
                            <label asp-for="RememberMe" class="form-check-label text-muted small"></label>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-terracotta w-100 py-3 rounded-pill fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-2 mb-3">
                            <i class="bi bi-box-arrow-in-right fs-5"></i>
                            <span>Đăng Nhập</span>
                        </button>

                        <div class="text-center small text-muted">
                            Chưa có tài khoản độc giả? 
                            <a asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" class="text-terracotta fw-semibold text-decoration-none">
                                Đăng ký ngay
                            </a>
                        </div>
                    </form>

                    <!-- Fast Demo Credentials Fill Boxes -->
                    <div class="mt-4 pt-3 border-top space-y-3" style="border-color: rgba(222, 192, 183, 0.35) !important;">
                        <!-- Customer Demo Box -->
                        <div class="p-3 bg-surface-low rounded-3 border small mb-2" style="border-color: rgba(81, 99, 79, 0.35) !important;">
                            <div class="fw-bold text-dark d-flex align-items-center justify-content-between mb-1">
                                <span><i class="bi bi-person-fill text-sage me-1"></i> Tài khoản Độc Giả (Khách hàng):</span>
                                <button type="button" class="btn btn-sm btn-outline-success py-0 px-2 rounded-pill" style="font-size: 0.75rem;" onclick="fillCustomerCredentials()">
                                    Điền nhanh
                                </button>
                            </div>
                            <div class="text-muted font-monospace" style="font-size: 0.8rem;">
                                <div>Email: <strong>user@pagecraft.com</strong></div>
                                <div>Mật khẩu: <strong>User@123456</strong></div>
                            </div>
                        </div>

                        <!-- Admin Demo Box -->
                        <div class="p-3 bg-surface-low rounded-3 border small" style="border-color: rgba(200, 90, 56, 0.35) !important;">
                            <div class="fw-bold text-dark d-flex align-items-center justify-content-between mb-1">
                                <span><i class="bi bi-shield-lock-fill text-terracotta me-1"></i> Tài khoản Quản Trị Viên (Admin):</span>
                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 rounded-pill" style="font-size: 0.75rem;" onclick="fillAdminCredentials()">
                                    Điền nhanh
                                </button>
                            </div>
                            <div class="text-muted font-monospace" style="font-size: 0.8rem;">
                                <div>Email: <strong>admin@pagecraft.com</strong></div>
                                <div>Mật khẩu: <strong>Admin@123456</strong></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
    <script>
        function fillCustomerCredentials() {
            document.getElementById('loginEmail').value = 'user@pagecraft.com';
            document.getElementById('loginPassword').value = 'User@123456';
        }

        function fillAdminCredentials() {
            document.getElementById('loginEmail').value = 'admin@pagecraft.com';
            document.getElementById('loginPassword').value = 'Admin@123456';
        }
    </script>
}
