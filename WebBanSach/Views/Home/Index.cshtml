            </div>
            <!-- Filter Pills -->
            <div class="d-flex flex-wrap gap-2 p-1 rounded-pill bg-surface-low border">
                <button class="btn btn-sm btn-terracotta px-3 py-1 rounded-pill">Tất Cả</button>
                <button class="btn btn-sm text-muted px-3 py-1 rounded-pill">Tiểu Thuyết</button>
                <button class="btn btn-sm text-muted px-3 py-1 rounded-pill">Phi Hư Cấu</button>
