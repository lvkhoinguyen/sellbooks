@model IEnumerable<Category>
@{
    ViewData["Title"] = "Trang Chủ - Nhà Sách Độc Lập PageCraft";
}

<!-- 1. HERO SECTION -->
<section class="py-5 position-relative overflow-hidden">
    <!-- Ambient Blur Background Elements -->
    <div class="position-absolute top-0 end-0 rounded-circle pointer-events-none" style="width: 420px; height: 420px; background: rgba(200, 90, 50, 0.08); filter: blur(90px); z-index: 0;"></div>
    <div class="position-absolute bottom-0 start-0 rounded-circle pointer-events-none" style="width: 350px; height: 350px; background: rgba(81, 99, 79, 0.08); filter: blur(80px); z-index: 0;"></div>

    <div class="container px-4 px-lg-5 position-relative" style="z-index: 1;">
        <div class="row align-items-center g-5">
            <!-- Left Editorial Text -->
            <div class="col-lg-7 text-start">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-4" style="background: var(--bg-surface-high);">
                    <span class="rounded-circle bg-terracotta d-inline-block" style="width: 8px; height: 8px;"></span>
                    <span class="text-uppercase fw-bold small text-terracotta" style="font-size: 0.75rem; letter-spacing: 0.12em;">Tuyển Chọn Nổi Bật • Mùa Thu 2026</span>
                </div>

                <h1 class="display-4 fw-bold mb-4 text-dark font-serif" style="line-height: 1.15;">
                    Những Câu Chuyện <span class="fst-italic fw-normal text-terracotta">Đọng Lại</span> Cùng Năm Tháng.
                </h1>

                <p class="lead text-muted mb-4 pe-lg-5" style="line-height: 1.7; font-size: 1.1rem;">
                    Tuyển tập tác phẩm văn học sâu sắc, triết luận trường tồn và sách nghệ thuật dành cho độc giả tinh tế. Mỗi ấn bản đều được lựa chọn với sự trân quý tuyệt đối đối với từng trang sách in.
                </p>

                <!-- Action Buttons -->
                <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                    <a href="#bestsellers" class="btn btn-terracotta d-inline-flex align-items-center gap-2">
                        <span>Khám Phá Sách Hay</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                    <a asp-controller="Category" asp-action="Index" class="btn btn-outline-terracotta d-inline-flex align-items-center gap-2">
                        <i class="bi bi-bookmarks"></i>
                        <span>Xem Toàn Bộ Thể Loại</span>
                    </a>
                </div>

                <!-- Social Proof -->
                <div class="d-inline-flex align-items-center gap-3 p-2 px-3 rounded-pill bg-white shadow-sm border border-light">
                    <div class="text-warning d-flex">
                        <i class="bi bi-star-fill text-terracotta"></i>
                        <i class="bi bi-star-fill text-terracotta ms-1"></i>
                        <i class="bi bi-star-fill text-terracotta ms-1"></i>
                        <i class="bi bi-star-fill text-terracotta ms-1"></i>
                        <i class="bi bi-star-fill text-terracotta ms-1"></i>
                    </div>
                    <span class="small text-muted">
                        <strong class="text-dark">4.9/5</strong> từ hơn 12.000 độc giả thân thiết
                    </span>
                </div>
            </div>

            <!-- Right 3D Book Showcase -->
            <div class="col-lg-5 text-center">
                <div class="position-relative d-inline-block mx-auto" style="max-width: 360px;">
                    <!-- Ribbon -->
                    <div class="position-absolute top-0 end-0 translate-middle-y me-3 bg-sage text-white px-3 py-1 rounded-pill shadow-sm small fw-bold text-uppercase d-flex align-items-center gap-1" style="z-index: 3; letter-spacing: 0.08em; font-size: 0.72rem;">
                        <i class="bi bi-stars"></i>
                        <span>Sách Tiêu Biểu • Tháng 10</span>
                    </div>

                    <!-- Book Card Container -->
                    <div class="bg-white p-4 rounded-4 shadow-lg text-start position-relative" style="z-index: 2; border: 1px solid rgba(222, 192, 183, 0.4);">
                        <div class="book-cover-container mb-3" style="aspect-ratio: 3/4;">
                            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBXfB6zfERYPybvsHk6_001w9XriafDx-0J6zio3sU9CJg0tcsYs5D0spPza8S2p7E8Y6LONHvD-kX012pcPXJzh38ETdJMWvIdRx6lQsSt5gvnMmdl_AMhC5mxJEphT25QAhBGsA-Cu-B_ta3m9swZcMwkNYh-gdrnjUPRQ6Knxde2uQN0OvLxM6USncHpbV5Jfm2OMVglg_cehHPFlf-61jFqWwzsxrbCi9LAELl38QNCwW02vFk" 
                                 alt="The Echoes of Autumn" class="w-100 h-100 object-fit-cover" />
                            <div class="book-spine-crease"></div>
                        </div>

                        <div class="p-3 rounded-3 bg-surface-low d-flex align-items-center justify-content-between">
                            <div>
                                <h5 class="font-serif fw-bold mb-1 fs-6 text-dark">The Echoes of Autumn</h5>
                                <p class="small text-muted mb-0">Tác giả Eliza J. Harrison • <span class="text-sage fw-semibold">Bìa cứng</span></p>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-terracotta fs-5">245.000₫</div>
                                <small class="text-muted text-decoration-line-through">295.000₫</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2. CURATED CATEGORIES SECTION -->
<section id="categories" class="py-5 bg-surface-low border-top border-bottom" style="border-color: rgba(222, 192, 183, 0.4) !important;">
    <div class="container px-4 px-lg-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-2">
            <div>
                <span class="text-uppercase fw-bold text-terracotta small" style="letter-spacing: 0.12em;">Không Gian Đọc Sách</span>
                <h2 class="font-serif fw-bold text-dark mb-0">Khám Phá Theo Cảm Hứng</h2>
            </div>
            <a asp-controller="Category" asp-action="Index" class="text-terracotta text-decoration-none fw-semibold d-inline-flex align-items-center gap-1">
                <span>Quản Lý Tất Cả Danh Mục</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-3">
            @if (Model != null && Model.Any())
            {
                var sampleIcons = new[] { "bi-book", "bi-compass", "bi-lightbulb", "bi-cpu", "bi-pen", "bi-palette" };
                int iconIdx = 0;
                foreach (var cat in Model.Take(6))
                {
                    var icon = sampleIcons[iconIdx % sampleIcons.Length];
                    iconIdx++;
                    <div class="col-6 col-md-4 col-lg-2">
                        <a asp-controller="Category" asp-action="Edit" asp-route-id="@cat.Id" class="category-portal-card">
                            <div class="category-icon-bubble">
                                <i class="bi @icon"></i>
                            </div>
                            <h6 class="fw-bold mb-1 text-truncate w-100">@cat.Name</h6>
                            <small class="text-muted">Thứ tự: @cat.DisplayOrder</small>
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="category-portal-card">
                        <div class="category-icon-bubble"><i class="bi bi-book"></i></div>
                        <h6 class="fw-bold mb-1">Văn Học &amp; Tiểu Thuyết</h6>
                        <small class="text-muted">420+ tựa sách</small>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="category-portal-card">
                        <div class="category-icon-bubble"><i class="bi bi-compass"></i></div>
                        <h6 class="fw-bold mb-1">Khoa Học Viễn Tưởng</h6>
                        <small class="text-muted">180+ tựa sách</small>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="category-portal-card">
                        <div class="category-icon-bubble"><i class="bi bi-lightbulb"></i></div>
                        <h6 class="fw-bold mb-1">Phát Triển Bản Thân</h6>
                        <small class="text-muted">210+ tựa sách</small>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="category-portal-card">
                        <div class="category-icon-bubble"><i class="bi bi-cpu"></i></div>
                        <h6 class="fw-bold mb-1">Công Nghệ &amp; Xã Hội</h6>
                        <small class="text-muted">130+ tựa sách</small>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="category-portal-card">
                        <div class="category-icon-bubble"><i class="bi bi-pen"></i></div>
                        <h6 class="fw-bold mb-1">Triết Học &amp; Tiểu Luận</h6>
                        <small class="text-muted">160+ tựa sách</small>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="category-portal-card">
                        <div class="category-icon-bubble"><i class="bi bi-palette"></i></div>
                        <h6 class="fw-bold mb-1">Manga &amp; Nghệ Thuật</h6>
                        <small class="text-muted">190+ tựa sách</small>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- 3. CURRENT BESTSELLERS -->
<section id="bestsellers" class="py-5">
    <div class="container px-4 px-lg-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3">
