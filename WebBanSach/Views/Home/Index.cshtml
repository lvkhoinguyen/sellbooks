            <div class="col-12 col-sm-6 col-lg-3">
                <div class="book-card">
                    <div class="book-cover-container mb-3" style="aspect-ratio: 1 / 1.4;">
                        <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBN7UXflRcfK2iAi6Q7ktXG16VHIzhiCSqNbS-QgTKx4V77mcdPuABhcXE2waFubol_Sstolx557PzGOyQO1ptFSKF5mWTP35DTqR3IIOjZs3QEVJ9uh85OK2TjtKXera3Dis5brCrD37JrY5aXFOlPRDtlnJS14zpqBQl1_cp_eLuwbOcqaT6jXDXryxjx_9E9QEV6TSfJzQ5I1333TF8R-E8mcjGIPRPADeEhe60UXXMqQEDJ38s" 
                             alt="Starlight Cartography" class="w-100 h-100 object-fit-cover" />
                        <div class="book-spine-crease"></div>
                        <span class="position-absolute top-0 start-0 m-2 badge bg-dark rounded-pill px-2 py-1 small fw-bold">Mới Xuất Bản</span>
                    </div>
                    <div class="d-flex align-items-center gap-1 text-terracotta small mb-1">
                        <i class="bi bi-star-fill"></i>
                        <span class="fw-bold text-dark">5.0</span>
                        <span class="text-muted">(129 đánh giá)</span>
                    </div>
