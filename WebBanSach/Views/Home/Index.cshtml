                    </div>
                    <div class="d-flex align-items-center gap-1 text-terracotta small mb-1">
                        <i class="bi bi-star-fill"></i>
                        <span class="fw-bold text-dark">4.8</span>
                        <span class="text-muted">(518 đánh giá)</span>
                    </div>
                    <h5 class="font-serif fw-bold text-dark fs-6 text-truncate mb-1">Quiet Mind, Deep Work</h5>
                    <p class="small text-muted mb-3">Dr. Aris Thorne</p>
                    <div class="mt-auto d-flex align-items-center justify-content-between pt-2 border-top">
                        <div>
                            <div class="fw-bold text-terracotta fs-5">185.000₫</div>
