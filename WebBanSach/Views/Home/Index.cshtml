                    </div>
                    <div class="d-flex align-items-center gap-1 text-terracotta small mb-1">
                        <i class="bi bi-star-fill"></i>
                        <span class="fw-bold text-dark">4.9</span>
                        <span class="text-muted">(890 đánh giá)</span>
                    </div>
                    <h5 class="font-serif fw-bold text-dark fs-6 text-truncate mb-1">Letters to a Stoic Companion</h5>
                    <p class="small text-muted mb-3">Marcus Lin</p>
                    <div class="mt-auto d-flex align-items-center justify-content-between pt-2 border-top">
                        <div>
                            <div class="fw-bold text-terracotta fs-5">175.000₫</div>
                            <small class="text-muted text-decoration-line-through">220.000₫</small>
                        </div>
