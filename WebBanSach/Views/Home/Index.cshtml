<!-- 4. PROMOTIONAL BANNER -->
<section id="promotions" class="py-5">
    <div class="container px-4 px-lg-5">
        <div class="p-4 p-md-5 rounded-4 position-relative overflow-hidden shadow-sm" style="background: linear-gradient(135deg, var(--bg-surface-high) 0%, var(--bg-surface-low) 100%); border: 1px solid rgba(222, 192, 183, 0.5);">
            <div class="row align-items-center g-4 position-relative" style="z-index: 2;">
                <div class="col-lg-8">
                    <div class="d-inline-flex align-items-center gap-2 text-terracotta text-uppercase fw-bold small mb-2" style="letter-spacing: 0.12em;">
                        <i class="bi bi-cup-hot-fill"></i>
                        <span>Sự Kiện Đọc Sách Mùa Thu</span>
                    </div>
                    <h2 class="font-serif fw-bold text-dark display-6 mb-2">Thảnh Thơi Cùng Từng Trang Sách</h2>
                    <p class="fs-5 text-terracotta font-serif mb-2">Mua 2 Cuốn Bất Kỳ, Giảm Thêm 10% Toàn Bộ Giỏ Hàng</p>
                    <p class="text-muted small mb-4">Gói ghém bình yên bên tách trà ấm và những trang sách mới. Tặng kèm bookmark dập nổi độc quyền từ xưởng in thủ công.</p>

                    <!-- Voucher box -->
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <div class="d-inline-flex align-items-center bg-white px-3 py-2 rounded-pill shadow-sm border gap-2">
                            <span class="small text-muted text-uppercase">MÃ:</span>
                            <span class="fw-bold text-terracotta font-monospace fs-6" id="couponCode">READMORE</span>
                            <button type="button" class="btn btn-sm btn-light rounded-pill px-2 py-0 small fw-bold" onclick="navigator.clipboard.writeText('READMORE'); this.innerHTML='Đã sao chép!'; setTimeout(()=>this.innerHTML='Sao chép', 2000)">Sao chép</button>
                        </div>
                        <span class="small text-sage fw-semibold d-inline-flex align-items-center gap-1">
                            <i class="bi bi-truck"></i> Miễn phí vận chuyển toàn quốc
                        </span>
                    </div>
                </div>

                <div class="col-lg-4 text-lg-end">
                    <a href="#bestsellers" class="btn btn-terracotta px-4 py-3 d-inline-flex align-items-center gap-2">
                        <span>Khám Phá Sách Khuyến Mãi</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 5. READER REVIEWS -->
<section id="community" class="py-5 bg-surface-low">
    <div class="container px-4 px-lg-5">
        <div class="text-center max-w-2xl mx-auto mb-5">
            <span class="text-uppercase fw-bold text-sage small" style="letter-spacing: 0.12em;">Cộng Đồng Độc Giả</span>
            <h2 class="font-serif fw-bold text-dark mt-1">Cảm Nhận Từ Những Người Yêu Sách</h2>
            <p class="text-muted small">Hơn 45.000 cuốn sách đã được gửi gắm đến những góc đọc yên bình khắp mọi miền đất nước.</p>
        </div>

        <div class="row g-4">
            <!-- Review 1 -->
            <div class="col-md-4">
                <div class="testimonial-card">
                    <div>
                        <div class="text-terracotta mb-3">
                            <i class="bi bi-star-fill"></i><i class="bi bi-star-fill ms-1"></i><i class="bi bi-star-fill ms-1"></i><i class="bi bi-star-fill ms-1"></i><i class="bi bi-star-fill ms-1"></i>
                        </div>
                        <p class="fst-italic text-dark mb-4" style="line-height: 1.6;">
                            “PageCraft đem lại cảm giác ấm cúng như bước vào một tiệm sách xưa ở phố cổ. Đóng gói rất chỉn chu, không hề cong mép và đi kèm bookmark dập nổi cực kỳ tinh tế.”
