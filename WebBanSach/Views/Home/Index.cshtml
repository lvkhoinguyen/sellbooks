                    <p class="small text-muted mb-3">Clara Vance</p>
                    <div class="mt-auto d-flex align-items-center justify-content-between pt-2 border-top">
                        <div>
                            <div class="fw-bold text-terracotta fs-5">215.000₫</div>
                            <small class="text-muted text-decoration-line-through">280.000₫</small>
                        </div>
                        <button class="btn btn-sm btn-terracotta rounded-pill px-3 d-flex align-items-center gap-1" title="Thêm vào giỏ">
                            <i class="bi bi-bag-plus"></i> Thêm
                        </button>
                    </div>
                </div>
            </div>

            <!-- Book 2 -->
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="book-card">
                    <div class="book-cover-container mb-3" style="aspect-ratio: 1 / 1.4;">
                        <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBzsmX4eK3it5BPUdmPOtAgsPomHItqM0GWWwHFs8PdrSuhjMoykUPiM0xqvlq76BFexEsOXEyFqsdJZ-DfjxYRvuMnQhfUJyt2cwjW7KrN3hdR2COC0FTCmcadbM3nxUomPDWftMNXw2nmvDfhrEoFS8qcw18SR8uR-uxVZQwEZz2V0WF6Liw88uMs4Mkajkd0IJiZhHKsG4Osjkv3JbdnCRae69IInZL-xLGo0gDIpvGtKdK1hLk" 
