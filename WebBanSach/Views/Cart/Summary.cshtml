@model ShoppingCartVM
@{
    ViewData["Title"] = "Xác Nhận & Đặt Hàng";
    decimal subTotal = 0;
    foreach (var item in Model.ShoppingCartList)
    {
        subTotal += (item.Price * item.Count);
    }
    bool isFreeShipping = subTotal >= 250000;
    decimal shippingFee = isFreeShipping ? 0 : 30000;
    decimal discount = Model.DiscountAmount;
    decimal finalTotal = Math.Max(0, subTotal + shippingFee - discount);
}

<div class="container px-4 px-lg-5 py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none">
                    <i class="bi bi-house-door me-1"></i>Trang Chủ
                </a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Cart" asp-action="Index" class="text-muted text-decoration-none">Giỏ Hàng</a>
            </li>
            <li class="breadcrumb-item active text-terracotta fw-semibold" aria-current="page">Xác Nhận Thanh Toán</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center gap-3">
            <span class="rounded-circle bg-terracotta text-white d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 1.3rem;">
                <i class="bi bi-check2-circle"></i>
            </span>
            <div>
                <h2 class="font-serif fw-bold text-dark mb-0 fs-3">Xác Nhận &amp; Đặt Hàng</h2>
                <p class="text-muted small mb-0">Kiểm tra thông tin giao nhận và hoàn tất đơn đặt sách của bạn</p>
            </div>
        </div>

        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2 d-none d-sm-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i> Quay lại giỏ hàng
        </a>
    </div>

    <form method="post" asp-action="Summary">
        <div class="row g-4">
            <!-- Left Column: Shipping Address Form -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4" style="border: 1px solid rgba(222, 192, 183, 0.45) !important; background-color: #ffffff;">
                    <div class="card-header bg-surface-low border-bottom py-3 px-4 d-flex align-items-center justify-content-between" style="border-color: rgba(222, 192, 183, 0.4) !important;">
                        <span class="fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;">
                            <i class="bi bi-geo-alt-fill text-terracotta me-2"></i>Địa Chỉ Nhận Hàng
                        </span>
                        <span class="badge bg-sage text-white rounded-pill px-2 py-1 small">Giao Tận Nơi</span>
                    </div>

                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label asp-for="OrderHeader.Name" class="form-label small fw-semibold text-dark">Họ và tên người nhận <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-surface-low text-muted border-end-0" style="border-color: rgba(222, 192, 183, 0.7);"><i class="bi bi-person"></i></span>
                                    <input asp-for="OrderHeader.Name" class="form-control border-start-0" placeholder="Ví dụ: Nguyễn Văn A" style="border-color: rgba(222, 192, 183, 0.7);" required />
                                </div>
                                <span asp-validation-for="OrderHeader.Name" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-sm-6">
                                <label asp-for="OrderHeader.PhoneNumber" class="form-label small fw-semibold text-dark">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-surface-low text-muted border-end-0" style="border-color: rgba(222, 192, 183, 0.7);"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="OrderHeader.PhoneNumber" class="form-control border-start-0" placeholder="Ví dụ: 0987654321" style="border-color: rgba(222, 192, 183, 0.7);" required />
                                </div>
                                <span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="OrderHeader.StreetAddress" class="form-label small fw-semibold text-dark">Địa chỉ chi tiết <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-surface-low text-muted border-end-0" style="border-color: rgba(222, 192, 183, 0.7);"><i class="bi bi-building"></i></span>
                                    <input asp-for="OrderHeader.StreetAddress" class="form-control border-start-0" placeholder="Số nhà, tên ngõ/đường, phường/xã..." style="border-color: rgba(222, 192, 183, 0.7);" required />
                                </div>
                                <span asp-validation-for="OrderHeader.StreetAddress" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="OrderHeader.City" class="form-label small fw-semibold text-dark">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-surface-low text-muted border-end-0" style="border-color: rgba(222, 192, 183, 0.7);"><i class="bi bi-map"></i></span>
                                    <input asp-for="OrderHeader.City" class="form-control border-start-0" placeholder="Ví dụ: Hà Nội, TP. Hồ Chí Minh, Đà Nẵng..." style="border-color: rgba(222, 192, 183, 0.7);" required />
                                </div>
                                <span asp-validation-for="OrderHeader.City" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Payment Method Option -->
                        <div class="mt-4 pt-3 border-top" style="border-color: rgba(222, 192, 183, 0.4) !important;">
                            <label class="form-label small fw-semibold text-dark mb-2">Phương thức thanh toán</label>
                            <div class="p-3 rounded-3 bg-surface-low border d-flex align-items-center justify-content-between" style="border-color: rgba(200, 90, 56, 0.3) !important;">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="radio" name="paymentMethod" id="codPayment" checked />
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark small">Thanh toán khi nhận hàng (COD)</div>
                                        <small class="text-muted">Kiểm tra sách rồi thanh toán tiền mặt cho shipper</small>
                                    </div>
                                </div>
                                <span class="badge bg-terracotta text-white rounded-pill px-3 py-1 small">Khuyên Dùng</span>
                            </div>
                        </div>

                        <!-- Estimated Delivery -->
                        <div class="p-3 mt-3 bg-surface-low rounded-3 border d-flex align-items-center gap-3" style="border-color: rgba(222, 192, 183, 0.5) !important;">
                            <i class="bi bi-truck fs-4 text-terracotta"></i>
                            <div>
                                <div class="fw-bold text-dark small">Thời gian giao hàng dự kiến: 2 - 4 ngày làm việc</div>
                                <small class="text-muted">Đơn hàng được bao bọc túi chống sốc cẩn thận trước khi gửi</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Order Summary & Review -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden sticky-top" style="top: 100px; border: 1px solid rgba(222, 192, 183, 0.45) !important; background-color: #ffffff;">
                    <div class="card-header bg-surface-low border-bottom py-3 px-4 d-flex align-items-center justify-content-between" style="border-color: rgba(222, 192, 183, 0.4) !important;">
                        <span class="fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;">
                            <i class="bi bi-journal-bookmark-fill text-terracotta me-2"></i>Ấn Phẩm Đặt Mua
                        </span>
                        <span class="badge bg-terracotta text-white rounded-pill px-2 py-1 small">@Model.ShoppingCartList.Count() đầu sách</span>
                    </div>

                    <div class="card-body p-4 bg-white">
                        <!-- Items List -->
                        <div class="space-y-3 pb-3 border-bottom" style="max-height: 280px; overflow-y: auto; border-color: rgba(222, 192, 183, 0.35) !important;">
                            @foreach (var item in Model.ShoppingCartList)
                            {
                                var lineTotal = item.Price * item.Count;
                                <div class="d-flex align-items-center justify-content-between gap-3 mb-3 pb-2 border-bottom border-light">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-2 overflow-hidden shadow-xs border bg-surface-low" style="width: 42px; height: 58px; flex-shrink: 0; border-color: rgba(222, 192, 183, 0.5) !important;">
                                            @if (!string.IsNullOrEmpty(item.Book?.ImageUrl))
                                            {
                                                <img src="@item.Book.ImageUrl" alt="@item.Book.Title" class="w-100 h-100 object-fit-cover" />
                                            }
                                            else
                                            {
                                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted"><i class="bi bi-book"></i></div>
                                            }
                                        </div>
                                        <div>
                                            <h6 class="font-serif fw-bold text-dark mb-0 fs-6 text-truncate" style="max-width: 170px;" title="@item.Book?.Title">
                                                @(item.Book?.Title ?? "Ấn phẩm")
                                            </h6>
                                            <small class="text-muted d-block">Số lượng: <strong class="text-dark">@item.Count</strong> × @item.Price.ToString("#,##0")₫</small>
                                        </div>
                                    </div>
                                    <div class="text-end fw-bold font-serif text-terracotta small">
                                        @lineTotal.ToString("#,##0") ₫
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Coupon / Voucher Section in Summary -->
                        <div class="my-3 p-3 rounded-3 bg-surface-low border" style="border-color: rgba(222, 192, 183, 0.6) !important;">
                            <label class="form-label small fw-bold text-dark d-flex align-items-center gap-1 mb-2">
                                <i class="bi bi-tag-fill text-terracotta"></i>
                                <span>Mã Giảm Giá / Voucher</span>
                            </label>

                            @if (!string.IsNullOrEmpty(Model.CouponCode) && Model.DiscountAmount > 0)
                            {
                                <div class="d-flex align-items-center justify-content-between p-2 bg-success-subtle border border-success-subtle rounded-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                        <div>
                                            <span class="fw-bold text-success small font-monospace">@Model.CouponCode</span>
                                            <small class="d-block text-success" style="font-size: 0.75rem;">Đã giảm @Model.DiscountAmount.ToString("#,##0")₫</small>
                                        </div>
                                    </div>
                                    <button type="button" id="removeSummaryCouponBtn" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-1" title="Hủy mã giảm giá">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex gap-2">
                                    <input type="text" name="couponCode" id="summaryCouponInput" class="form-control form-control-sm text-uppercase font-monospace" placeholder="Mã giảm giá..." style="border-color: rgba(222, 192, 183, 0.7);" />
                                    <button type="button" id="applySummaryCouponBtn" class="btn btn-sm btn-terracotta text-white rounded-pill px-3 fw-semibold text-nowrap">
                                        Áp Dụng
                                    </button>
                                </div>
                                <div class="d-flex flex-wrap gap-1 align-items-center pt-2">
                                    <small class="text-muted" style="font-size: 0.72rem;">Gợi ý:</small>
                                    <button type="button" class="badge bg-white text-terracotta border border-terracotta rounded-pill px-2 py-1 small fw-normal coupon-summary-btn" data-code="READMORE" style="cursor: pointer;">
                                        READMORE (-10%)
                                    </button>
                                    <button type="button" class="badge bg-white text-terracotta border border-terracotta rounded-pill px-2 py-1 small fw-normal coupon-summary-btn" data-code="PAGECRAFT50" style="cursor: pointer;">
                                        PAGECRAFT50 (-50k)
                                    </button>
                                </div>
                            }
                        </div>

                        <!-- Price Calculations -->
                        <div class="pt-2 pb-3 border-bottom space-y-2" style="border-color: rgba(222, 192, 183, 0.35) !important;">
                            <div class="d-flex justify-content-between align-items-center small mb-2">
                                <span class="text-muted">Tổng tiền ấn phẩm:</span>
                                <span class="fw-semibold text-dark">@subTotal.ToString("#,##0") ₫</span>
                            </div>

                            @if (Model.DiscountAmount > 0)
                            {
                                <div class="d-flex justify-content-between align-items-center small mb-2 text-success">
                                    <span>
                                        <i class="bi bi-tag-fill me-1"></i>Mã giảm giá (@Model.CouponCode):
                                    </span>
                                    <span class="fw-bold">-@Model.DiscountAmount.ToString("#,##0") ₫</span>
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center small mb-2">
                                <span class="text-muted">Phí giao hàng toàn quốc:</span>
                                <span class="fw-semibold @(isFreeShipping ? "text-success" : "text-dark")">
                                    @(isFreeShipping ? "Miễn phí" : "30.000 ₫")
                                </span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center small">
                                <span class="text-muted">Đóng gói tiêu chuẩn PageCraft:</span>
                                <span class="fw-semibold text-success">Miễn phí</span>
                            </div>
                        </div>

                        <!-- Total Payment -->
                        <div class="d-flex justify-content-between align-items-center pt-3 mb-4">
                            <div>
                                <span class="fw-bold text-dark d-block">Tổng Cần Thanh Toán</span>
                                <small class="text-muted" style="font-size: 0.72rem;">Đã bao gồm VAT, mã giảm giá &amp; phí vận chuyển</small>
                            </div>
                            <div class="font-serif fw-bold text-terracotta fs-3">
                                @finalTotal.ToString("#,##0") ₫
                            </div>
                        </div>

                        <!-- Submit Order Button -->
                        <button type="submit" class="btn btn-terracotta w-100 py-3 rounded-pill fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-2 mb-3">
                            <i class="bi bi-shield-lock-fill"></i>
                            <span>Xác Nhận Đặt Hàng (COD)</span>
                        </button>

                        <div class="text-center">
                            <small class="text-muted" style="font-size: 0.75rem;">
                                <i class="bi bi-shield-check text-sage me-1"></i>Bằng việc đặt hàng, bạn đồng ý với Điều khoản mua sắm của PageCraft Booksellers
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.coupon-summary-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const code = this.getAttribute('data-code');
                const input = document.getElementById('summaryCouponInput');
                if (input && code) {
                    input.value = code;
                    input.focus();
                }
            });
        });

        // Áp dụng mã trong trang Summary qua AJAX
        const applySummaryBtn = document.getElementById('applySummaryCouponBtn');
        if (applySummaryBtn) {
            applySummaryBtn.addEventListener('click', async function(e) {
                e.preventDefault();
                const input = document.getElementById('summaryCouponInput');
                const code = input ? input.value.trim() : '';
                if (!code) {
                    if (window.toastr) toastr.warning('Vui lòng nhập mã giảm giá.');
                    return;
                }

                const origHtml = applySummaryBtn.innerHTML;
                applySummaryBtn.disabled = true;
                applySummaryBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>';

                try {
                    const formData = new FormData();
                    formData.append('couponCode', code);
                    formData.append('returnUrl', '/Cart/Summary');

                    const res = await fetch('@Url.Action("ApplyCoupon", "Cart")', {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: formData
                    });

                    const data = await res.json();
                    if (data.success) {
                        if (window.toastr) toastr.success(data.message);
                        setTimeout(() => window.location.reload(), 400);
                    } else {
                        if (window.toastr) toastr.error(data.message || 'Mã không hợp lệ');
                        applySummaryBtn.disabled = false;
                        applySummaryBtn.innerHTML = origHtml;
                    }
                } catch {
                    // Fallback
                    const f = applySummaryBtn.closest('form');
                    if (f) {
                        f.action = '@Url.Action("ApplyCoupon", "Cart", new { returnUrl = "/Cart/Summary" })';
                        f.submit();
                    }
                }
            });
        }

        // Hủy mã trong trang Summary qua AJAX
        const removeSummaryBtn = document.getElementById('removeSummaryCouponBtn');
        if (removeSummaryBtn) {
            removeSummaryBtn.addEventListener('click', async function(e) {
                e.preventDefault();
                try {
                    const res = await fetch('@Url.Action("RemoveCoupon", "Cart")', {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });
                    const data = await res.json();
                    if (data.success) {
                        if (window.toastr) toastr.info(data.message);
                        setTimeout(() => window.location.reload(), 400);
                    } else {
                        window.location.reload();
                    }
                } catch {
                    window.location.reload();
                }
            });
        }
    </script>
}
